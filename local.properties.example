# Copy this file to local.properties and fill in values for plugins that need API keys.
# local.properties is gitignored and will NOT be pushed to GitHub.
#
# Atau jalankan: python write_local_properties.py
# (set env var dulu, atau sdk.dir diambil dari ANDROID_HOME / file ini)

